<div class="calm-search">
    <input type="search"
           class="calm-search-input"
           placeholder="Search Google…"
           aria-label="Search Google"
           @onkeydown="@SearchOnEnter"
           @bind="SearchString"
           @bind:event="oninput" />
    <button type="button" class="calm-search-button" @onclick="RunSearch">Search</button>
</div>
