<label class="calm-widget-config-row">
    <input type="checkbox" aria-label="24-hour clock" checked="@Config.Use24Hour" @onchange="Set24HourAsync" />
    24-hour clock
</label>
<label class="calm-widget-config-row">
    <input type="checkbox" aria-label="Show seconds" checked="@Config.ShowSeconds" @onchange="SetSecondsAsync" />
    Show seconds
</label>
