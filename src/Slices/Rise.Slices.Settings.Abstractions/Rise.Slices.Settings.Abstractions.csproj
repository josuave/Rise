<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Abstractions only for the Settings slice (Microsoft.Extensions.*.Abstractions
    pattern): interfaces for contracts the Settings slice exposes to other
    slices, no implementations, no dependencies. This library belongs to
    Settings, not to the core: it is separate from the core (Domain /
    Application / Infrastructure, whose ports still live in Application)
    and separate from any future core abstractions library, which would
    hold only contracts shared across slices, not settings-specific ones.
  -->

</Project>
