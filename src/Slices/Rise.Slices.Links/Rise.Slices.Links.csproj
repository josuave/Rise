<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" />
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions is available implicitly; do not reference it (NU1510). -->
  </ItemGroup>

  <ItemGroup>
    <!-- Slice depends only on the core's ports/services, never on Infrastructure (the adapters). -->
    <ProjectReference Include="..\..\Rise.Application\Rise.Application.csproj" />
    <ProjectReference Include="..\..\Rise.Slices.Abstractions\Rise.Slices.Abstractions.csproj" />
  </ItemGroup>

</Project>
