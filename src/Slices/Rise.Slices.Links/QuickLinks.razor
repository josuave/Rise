@using Rise.Domain

<div class="calm-links">
    @foreach (var link in Page.Links)
    {
        <div class="calm-link">
            <a class="calm-link-target" href="@link.Url.Value" target="_blank" rel="noopener noreferrer" title="@link.Url.Value">
                <span class="calm-link-initials">@link.Initials</span>
                <span class="calm-link-name">@link.Name</span>
            </a>
        </div>
    }
</div>

<button type="button" class="calm-edit-toggle" @onclick="ShowEditorAsync">Edit links</button>
