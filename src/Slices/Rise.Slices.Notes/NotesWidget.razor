@using Rise.Domain

<div class="calm-notes">
    <div class="calm-notes-header">
        <h2 class="calm-notes-title">Notes</h2>
        <button type="button" class="calm-notes-view-toggle" aria-label="@(PostItView ? "Switch to list view" : "Switch to post-it view")" @onclick="ToggleViewAsync">@(PostItView ? "List" : "Post-its")</button>
    </div>
    <div class="calm-add-form">
        <textarea placeholder="Write a note" aria-label="New note" @bind="NewText"></textarea>
        <button type="button" @onclick="AddAsync">Add note</button>
    </div>
    @if (!string.IsNullOrEmpty(FormError))
    {
        <p class="calm-form-error">@FormError</p>
    }

    @if (PostItView)
    {
        <div class="calm-notes-postits">
            @foreach (var note in List.Items)
            {
                <article class="calm-note-postit @PastelClass(note)">
                    @if (EditingId == note.Id)
                    {
                        <textarea class="calm-note-postit-edit" aria-label="Edit note" @bind="EditText"></textarea>
                        <div class="calm-note-postit-actions">
                            <button type="button" class="calm-note-save" @onclick="SaveEditAsync">Save</button>
                            <button type="button" class="calm-note-action" @onclick="CancelEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <span class="calm-note-postit-text">@note.Text</span>
                        <div class="calm-note-postit-actions">
                            <button type="button" class="calm-note-action" aria-label="Edit @note.Text" @onclick="() => StartEdit(note)">Edit</button>
                            <button type="button" class="calm-note-remove" aria-label="Delete @note.Text" @onclick="() => DeleteAsync(note)">×</button>
                        </div>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <div class="calm-notes-list">
            @foreach (var note in List.Items)
            {
                <div class="calm-note-row">
                    @if (EditingId == note.Id)
                    {
                        <textarea aria-label="Edit note" @bind="EditText"></textarea>
                        <button type="button" class="calm-note-save" @onclick="SaveEditAsync">Save</button>
                        <button type="button" class="calm-note-action" @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <span class="calm-note-text">@note.Text</span>
                        <button type="button" class="calm-note-action" aria-label="Edit @note.Text" @onclick="() => StartEdit(note)">Edit</button>
                        <button type="button" class="calm-note-remove" aria-label="Delete @note.Text" @onclick="() => DeleteAsync(note)">×</button>
                    }
                </div>
            }
        </div>
    }
</div>
