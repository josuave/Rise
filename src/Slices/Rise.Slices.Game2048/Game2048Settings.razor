<div class="calm-game2048-settings">
    <p class="calm-game2048-settings-best">Best score <strong>@State.Best</strong></p>
    <div class="calm-game2048-settings-actions">
        <button type="button" class="calm-game2048-settings-new" @onclick="NewGameAsync">New game</button>
        <button type="button" class="calm-game2048-settings-reset" @onclick="ResetBestAsync">Reset best score</button>
    </div>
</div>
