@using Microsoft.AspNetCore.Components

<button type="button" class="calm-settings-gear" aria-label="Settings" @onclick="Open">&#9881;</button>

@if (IsOpen)
{
    <div class="calm-dialog-overlay" @onclick="Close">
        <div class="calm-dialog" role="dialog" aria-label="Settings" @onclick:stopPropagation="true">
            <div class="calm-dialog-header">
                <h2>Settings</h2>
                <button type="button" class="calm-dialog-close" aria-label="Close settings" @onclick="Close">&times;</button>
            </div>

            <section>
                <h3>Theme</h3>
                <p class="calm-dialog-note">System follows your device setting.</p>
                <div class="calm-theme-options">
                    <button type="button" class="calm-theme-option@(StoredTheme == "light" ? " selected" : "")" aria-pressed="@(StoredTheme == "light")" @onclick='() => SetThemeAsync("light")'>Light</button>
                    <button type="button" class="calm-theme-option@(StoredTheme == "dark" ? " selected" : "")" aria-pressed="@(StoredTheme == "dark")" @onclick='() => SetThemeAsync("dark")'>Dark</button>
                    <button type="button" class="calm-theme-option@(StoredTheme == "system" ? " selected" : "")" aria-pressed="@(StoredTheme == "system")" @onclick='() => SetThemeAsync("system")'>System</button>
                </div>

                @foreach (var custom in CustomThemes)
                {
                    <div class="calm-theme-custom-row">
                        <button type="button" class="calm-theme-option@(IsActive(custom) ? " selected" : "")" aria-pressed="@IsActive(custom)" @onclick="() => SetCustomThemeAsync(custom)">@custom.Name</button>
                        <button type="button" aria-label="Edit @custom.Name" @onclick="() => EditingTheme = custom">Edit</button>
                        <button type="button" aria-label="Delete @custom.Name" @onclick="() => DeleteThemeAsync(custom.Id)">Delete</button>
                    </div>
                }

                <button type="button" class="calm-theme-new" @onclick="CreateThemeAsync">New theme</button>

                @if (EditingTheme is not null)
                {
                    <ThemeEditor Theme="EditingTheme" OnSave="SaveThemeAsync" OnCancel="CancelEdit" />
                }
            </section>

            @foreach (var section in Sections.OrderBy(s => s.Order))
            {
                <section>
                    <h3>@section.Title</h3>
                    @if (!string.IsNullOrEmpty(section.Description))
                    {
                        <p class="calm-dialog-note">@section.Description</p>
                    }
                    <DynamicComponent Type="@section.ComponentType" />
                </section>
            }
        </div>
    </div>
}
