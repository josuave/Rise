@using Rise.Domain

<div class="calm-layout-editor">
    <h3>Layouts</h3>
    <p class="calm-dialog-note">Switch between saved arrangements, or save the current one under a new name.</p>

    @foreach (var saved in Collection.Layouts)
    {
        <div class="calm-layout-row">
            <span class="calm-layout-name">@saved.Name</span>
            @if (saved.Id == Collection.ActiveId)
            {
                <span class="calm-layout-zone">Active</span>
            }
            else
            {
                <button type="button" aria-label="Switch to @saved.Name" @onclick="() => SwitchAsync(saved.Id)">Switch</button>
            }
            @if (saved.Id != LayoutCollection.DefaultId)
            {
                <button type="button" aria-label="Delete @saved.Name" @onclick="() => DeleteAsync(saved.Id)">Delete</button>
            }
        </div>
    }

    <div class="calm-layout-save-as">
        <input type="text" placeholder="New layout name" aria-label="New layout name" @bind="NewLayoutName" />
        <button type="button" @onclick="SaveAsAsync" disabled="@string.IsNullOrWhiteSpace(NewLayoutName)">Save current as new</button>
    </div>

    <div class="calm-layout-rename">
        <input type="text" aria-label="Rename active layout" @bind="RenameName" />
        <button type="button" @onclick="RenameAsync" disabled="@string.IsNullOrWhiteSpace(RenameName)">Rename active</button>
    </div>

    <h3>Widgets in this layout</h3>
    <p class="calm-dialog-note">Move widgets within their area, hide the ones you don't want, or reset to defaults. Changes save automatically.</p>

    @foreach (var placement in Layout.TopLevelWidgets())
    {
        <div class="calm-layout-row">
            <span class="calm-layout-name">@TitleOf(placement)</span>
            <span class="calm-layout-zone">@(placement.Zone == WidgetZone.Cluster ? "Top-right" : "Main")</span>
            <button type="button" aria-label="Move @TitleOf(placement) up" disabled="@IsFirstInZone(placement)" @onclick="() => MoveUpAsync(placement)">↑</button>
            <button type="button" aria-label="Move @TitleOf(placement) down" disabled="@IsLastInZone(placement)" @onclick="() => MoveDownAsync(placement)">↓</button>
            <button type="button" aria-label="@(placement.Visible ? "Hide" : "Show") @TitleOf(placement)" @onclick="() => ToggleVisibleAsync(placement)">
                @(placement.Visible ? "Hide" : "Show")
            </button>
            @if (IsGroup(placement))
            {
                @if (ConfirmingGroupDelete)
                {
                    <button type="button" aria-label="Delete group only" @onclick="DeleteGroupOnlyAsync">Delete group only</button>
                    <button type="button" aria-label="Delete group and widgets" @onclick="DeleteGroupAndWidgetsAsync">Delete group and widgets</button>
                    <button type="button" aria-label="Cancel group delete" @onclick="() => ConfirmingGroupDelete = false">Cancel</button>
                }
                else
                {
                    <button type="button" aria-label="Delete group" @onclick="() => ConfirmingGroupDelete = true">Delete</button>
                }
            }
            else if (placement.Zone == WidgetZone.Main)
            {
                <button type="button" aria-label="Add @TitleOf(placement) to group" @onclick="() => AddToGroupAsync(placement)">Into group</button>
            }
        </div>
        @if (IsGroup(placement))
        {
            @foreach (var child in Layout.GroupedWidgets())
            {
                <div class="calm-layout-row calm-layout-child">
                    <span class="calm-layout-name">@TitleOf(child)</span>
                    <span class="calm-layout-zone">Main</span>
                    <button type="button" aria-label="Move @TitleOf(child) up" disabled="@IsFirstInGroup(child)" @onclick="() => MoveUpAsync(child)">↑</button>
                    <button type="button" aria-label="Move @TitleOf(child) down" disabled="@IsLastInGroup(child)" @onclick="() => MoveDownAsync(child)">↓</button>
                    <button type="button" aria-label="@(child.Visible ? "Hide" : "Show") @TitleOf(child)" @onclick="() => ToggleVisibleAsync(child)">
                        @(child.Visible ? "Hide" : "Show")
                    </button>
                    <button type="button" aria-label="Remove @TitleOf(child) from group" @onclick="() => RemoveFromGroupAsync(child)">Out of group</button>
                </div>
            }
        }
    }

    <button type="button" class="calm-layout-reset" @onclick="ResetAsync">Reset to defaults</button>
</div>
