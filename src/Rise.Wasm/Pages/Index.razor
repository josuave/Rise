@page "/"
@implements IDisposable
@using Microsoft.AspNetCore.Components
@inject Rise.Application.Services.LayoutService LayoutService
@inject IEnumerable<Rise.Application.Ports.IWidgetDefinition> WidgetDefinitions

<PageTitle>Rise</PageTitle>

<div class="calm-settings-cluster">
    @foreach (var widget in Layout.ClusterWidgets().Where(w => w.Visible))
    {
        @if (ComponentFor(widget.Id) is Type clusterComponent)
        {
            <DynamicComponent Type="@clusterComponent" />
        }
    }
</div>

<div class="calm-page">
    @foreach (string id in MainTopLevelIds())
    {
        @if (IsGroup(id))
        {
            <Rise.Slices.Layout.GroupWidget>
                <ChildContent>
                    @foreach (var child in Layout.GroupedWidgets().Where(w => w.Visible))
                    {
                        @if (ComponentFor(child.Id) is Type childComponent)
                        {
                            <DynamicComponent Type="@childComponent" />
                        }
                    }
                </ChildContent>
            </Rise.Slices.Layout.GroupWidget>
        }
        else if (ComponentFor(id) is Type mainComponent)
        {
            <DynamicComponent Type="@mainComponent" />
        }
    }

    <button type="button" class="calm-layout-toggle" @onclick="() => EditingLayout = !EditingLayout">
        @(EditingLayout ? "Done" : "Edit layout")
    </button>

    @if (EditingLayout)
    {
        <Rise.Slices.Layout.LayoutEditor />
    }
</div>

@code {
    private Rise.Domain.PageLayout Layout { get; set; } =
        new Rise.Domain.PageLayout(Array.Empty<Rise.Domain.WidgetPlacement>());

    private bool EditingLayout { get; set; }

    /// <summary>
    /// The shell knows widgets only through their definitions: no
    /// switch on widget kinds anywhere in this page. A widget whose
    /// definition is missing is skipped rather than rendered. A group
    /// renders its member widgets inside its shell; every other widget
    /// renders on its own. The shell re-renders only when the layout
    /// changes; each widget owns its own refresh (the date, clock, and
    /// greeting widgets each own a timer).
    /// </summary>
    private Type? ComponentFor(string id) =>
        WidgetDefinitions.FirstOrDefault(d => d.Id == id)?.ComponentType;

    /// <summary>Ids of visible Main widgets that aren't inside the group: the page's top-level Main rows.</summary>
    private IEnumerable<string> MainTopLevelIds() =>
        Layout.TopLevelWidgets().Where(w => w.Zone == Rise.Domain.WidgetZone.Main && w.Visible).Select(w => w.Id);

    private bool IsGroup(string id) =>
        WidgetDefinitions.FirstOrDefault(d => d.Id == id)?.IsGroup ?? false;

    protected override async Task OnInitializedAsync()
    {
        Layout = await LayoutService.LoadAsync();
        LayoutService.Changed += OnLayoutChanged;
    }

    private async void OnLayoutChanged(object? sender, EventArgs args)
    {
        Layout = await LayoutService.LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (disposing)
        {
            LayoutService.Changed -= OnLayoutChanged;
        }
    }
}
