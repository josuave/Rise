@page "/"
@implements IDisposable
@inject Rise.Application.Ports.IClock Clock

<PageTitle>Rise</PageTitle>

<div class="calm-page">
    <p class="calm-date">@Rise.Domain.Greeting.FormatDate(Clock.Now)</p>
    <h1 class="calm-clock">@Rise.Domain.Greeting.FormatTime(Clock.Now)</h1>
    <p class="calm-greeting">@Rise.Domain.Greeting.For(Clock.Now)</p>

    <Rise.Slices.Search.Search />

    <Rise.Slices.Links.QuickLinks />
</div>

@code {
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
