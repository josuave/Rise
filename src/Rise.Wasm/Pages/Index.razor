@page "/"
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject Rise.Application.Services.LayoutService LayoutService
@inject IEnumerable<Rise.Application.Ports.IWidgetDefinition> WidgetDefinitions
@inject Rise.Application.Services.ModuleService ModuleService
@inject Rise.Application.Services.HotkeyService HotkeyService
@inject Rise.Application.Services.PreviewFeatureService PreviewFeatureService
@inject Rise.Application.Services.BackgroundService BackgroundService
@inject Rise.Application.Ports.IModuleCatalog ModuleCatalog
@inject Rise.Application.Ports.IThemeStore ThemeStore
@inject IJSInProcessRuntime JSInProcess

<PageTitle>Rise</PageTitle>

@if (BackgroundCss.Length > 0)
{
    <div class="calm-background" style="background-image: @(BackgroundCss);">
        <div class="calm-background-scrim"></div>
    </div>
}

<div class="calm-settings-cluster">
    @foreach (var widget in Layout.ClusterWidgets().Where(w => w.Visible && !IsWidgetDisabled(w.Id)))
    {
        @if (ComponentFor(widget.Id) is Type clusterComponent)
        {
            <DynamicComponent Type="@clusterComponent" />
        }
    }
</div>

<div class="calm-page@(BoardClass)">
    @if (CalmBoardFullPreview)
    {
        <div class="calm-board-bar">
            <span class="calm-board-bar-name">@ActiveLayoutName</span>
            <label class="calm-board-bar-switch">
                Layout
                <select aria-label="Switch layout" value="@Collection.ActiveId" @onchange="SwitchLayoutAsync">
                    @foreach (var saved in Collection.Layouts)
                    {
                        <option value="@saved.Id">@saved.Name</option>
                    }
                </select>
            </label>
            <button type="button" class="calm-board-bar-button" @onclick="() => EditingLayout = !EditingLayout">
                @(EditingLayout ? "Done" : "Edit board")
            </button>
            <button type="button" class="calm-board-bar-button" @onclick="ApplyDArrangementAsync">Apply D arrangement</button>
        </div>
        <div class="calm-board-top">
        @foreach (string id in CalmTopIds())
        {
            @if (IsGroup(id))
            {
                <div class="calm-widget-slot" data-widget="@id">
                <Rise.Slices.Layout.GroupWidget>
                    <ChildContent>
                        @foreach (var child in Layout.GroupedWidgets().Where(w => w.Visible && !IsWidgetDisabled(w.Id)))
                        {
                            @if (IsLazy(child.Id))
                            {
                                <LazyWidgetContainer WidgetId="@child.Id" />
                            }
                            else if (ComponentFor(child.Id) is Type childComponent)
                            {
                                <DynamicComponent Type="@childComponent" />
                            }
                        }
                    </ChildContent>
                </Rise.Slices.Layout.GroupWidget>
                </div>
            }
            else if (IsLazy(id))
            {
                <div class="calm-widget-slot" data-widget="@id">
                <LazyWidgetContainer WidgetId="@id" />
                </div>
            }
            else if (ComponentFor(id) is Type topComponent)
            {
                <div class="calm-widget-slot" data-widget="@id">
                <DynamicComponent Type="@topComponent" />
                </div>
            }
        }
        </div>
    }
    <div class="calm-widget-board">
    @foreach (string id in BoardIds())
    {
        @if (IsGroup(id))
        {
            <div class="calm-widget-slot" data-widget="@id">
            <Rise.Slices.Layout.GroupWidget>
                <ChildContent>
                    @foreach (var child in Layout.GroupedWidgets().Where(w => w.Visible && !IsWidgetDisabled(w.Id)))
                    {
                        @if (IsLazy(child.Id))
                        {
                            <LazyWidgetContainer WidgetId="@child.Id" />
                        }
                        else if (ComponentFor(child.Id) is Type childComponent)
                        {
                            <DynamicComponent Type="@childComponent" />
                        }
                    }
                </ChildContent>
            </Rise.Slices.Layout.GroupWidget>
            </div>
        }
        else if (IsLazy(id))
        {
            <div class="calm-widget-slot" data-widget="@id">
            <LazyWidgetContainer WidgetId="@id" />
            </div>
        }
        else if (ComponentFor(id) is Type mainComponent)
        {
            <div class="calm-widget-slot" data-widget="@id">
            <DynamicComponent Type="@mainComponent" />
            </div>
        }
    }
    @if (CalmBoardFullPreview)
    {
        <div class="calm-widget-slot calm-add-widget-slot" data-widget="AddWidget">
        @if (AddWidgetMenuOpen)
        {
            <div class="calm-add-widget-menu">
                @foreach (var hidden in HiddenMainWidgets())
                {
                    <button type="button" @onclick="() => ShowHiddenWidgetAsync(hidden.Id)">@hidden.Title</button>
                }
                <button type="button" class="calm-add-widget-cancel" @onclick="() => AddWidgetMenuOpen = false">Cancel</button>
            </div>
        }
        else
        {
            <button type="button" class="calm-add-widget-button" disabled="@(!HiddenMainWidgets().Any())" @onclick="() => AddWidgetMenuOpen = true">+ Add a widget</button>
        }
        </div>
    }
    </div>

    @if (ShowHint)
    {
        <div class="calm-hint">
            <span>Welcome to Rise — the gear opens Settings for links and themes, and Edit layout lets you move, hide, and save layouts.</span>
            <button type="button" class="calm-hint-dismiss" @onclick="DismissHint">Got it</button>
        </div>
    }

    <button type="button" class="calm-layout-toggle" title="Open the command palette (Ctrl+K)" @onclick="() => PaletteOpen = true">
        Commands
    </button>

    <button type="button" class="calm-layout-toggle" @onclick="() => EditingLayout = !EditingLayout">
        @(EditingLayout ? "Done" : "Edit layout")
    </button>

    @if (EditingLayout)
    {
        <Rise.Slices.Layout.LayoutEditor />
    }
</div>

@if (PaletteOpen)
{
    <CommandPalette OnClose="ClosePalette" OnToggleEditLayout="ToggleEditLayoutFromPalette" />
}

@code {
    private Rise.Domain.PageLayout Layout { get; set; } =
        new Rise.Domain.PageLayout(Array.Empty<Rise.Domain.WidgetPlacement>());

    /// <summary>The saved layouts, for the Edit board bar's name and switch control; kept in step with Layout.</summary>
    private Rise.Domain.LayoutCollection Collection { get; set; } = new Rise.Domain.LayoutCollection(
        Rise.Domain.LayoutCollection.DefaultId,
        Array.Empty<Rise.Domain.NamedLayout>());

    /// <summary>Ids of modules currently switched off. Disabled widgets render nothing, but their placements survive in the layout.</summary>
    private HashSet<string> DisabledModules { get; set; } = new();

    private bool EditingLayout { get; set; }

    private bool PaletteOpen { get; set; }

    /// <summary>Whether the Calm Board preview treatment is on: the page renders as a board instead of the calm stack.</summary>
    private bool CalmBoardPreview { get; set; }

    /// <summary>The CSS background-image value for the chosen page background; empty means the plain theme background.</summary>
    private string BackgroundCss { get; set; } = string.Empty;

    /// <summary>Whether the landscape-only Calm Board preview is on: the board shows only when the viewport is landscape.</summary>
    private bool CalmBoardLandscapePreview { get; set; }

    /// <summary>Whether the full Calm Board preview (mock-up D) is on: calm top over a board of warm-paper cards.</summary>
    private bool CalmBoardFullPreview { get; set; }

    /// <summary>Whether the add-widget menu is open (full board only).</summary>
    private bool AddWidgetMenuOpen { get; set; }

    /// <summary>
    /// The board classes for the page root. Precedence: the full board
    /// wins — when it is on, the page carries only calm-board-full,
    /// and the v0 and landscape classes are suppressed, so the full
    /// rules alone decide the board treatment. Otherwise the
    /// always-board class, the landscape-only class, or both — both
    /// on means the always-board wins, since its rules are not
    /// orientation-gated. The full flag is independent: it neither
    /// requires calm-board on nor forces it.
    /// </summary>
    private string BoardClass
    {
        get
        {
            if (CalmBoardFullPreview)
            {
                return " calm-board-full";
            }

            List<string> classes = new();
            if (CalmBoardPreview)
            {
                classes.Add("calm-board");
            }

            if (CalmBoardLandscapePreview)
            {
                classes.Add("calm-board-landscape");
            }

            return classes.Count == 0 ? string.Empty : " " + string.Join(" ", classes);
        }
    }

    /// <summary>Handle the shell hands to JS so the document keydown listener can call back into this page.</summary>
    private DotNetObjectReference<Index>? HotkeyRef { get; set; }

    /// <summary>Whether the first-run hint is showing: true until the user dismisses it once.</summary>
    private bool ShowHint { get; set; }

    private const string HintDismissedKey = "rise.hint.v1";

    /// <summary>
    /// The shell knows widgets only through their definitions: no
    /// switch on widget kinds anywhere in this page. A widget whose
    /// definition is missing is skipped rather than rendered. A group
    /// renders its member widgets inside its shell; every other widget
    /// renders on its own. The slot markup is written out in both the
    /// calm-top loop and the board loop rather than shared through a
    /// child component: the slot divs must stay in this file's own
    /// markup, or this file's scoped CSS (the board card treatment)
    /// stops matching them. The shell re-renders only when the layout
    /// changes; each widget owns its own refresh (the date, clock, and
    /// greeting widgets each own a timer).
    /// </summary>
    private Type? ComponentFor(string id) =>
        WidgetDefinitions.FirstOrDefault(d => d.Id == id)?.ComponentType;

    /// <summary>Ids of visible Main widgets that aren't inside the group: the page's top-level Main rows.</summary>
    private IEnumerable<string> MainTopLevelIds() =>
        Layout.TopLevelWidgets().Where(w => w.Zone == Rise.Domain.WidgetZone.Main && w.Visible && !IsWidgetDisabled(w.Id)).Select(w => w.Id);

    /// <summary>
    /// The calm-top ids, in layout order: with the full board on, the
    /// top widgets render as full-width unboxed rows above the board.
    /// Visibility and relative order always come from the stored
    /// layout; the split only partitions by the top-id set.
    /// </summary>
    private IEnumerable<string> CalmTopIds() =>
        CalmBoardFullPreview
            ? MainTopLevelIds().Where(id => Rise.Application.CalmBoardArrangement.TopIds.Contains(id))
            : Array.Empty<string>();

    /// <summary>The board ids: with the full board on, the Main rows minus the calm top; otherwise every Main row.</summary>
    private IEnumerable<string> BoardIds() =>
        CalmBoardFullPreview
            ? MainTopLevelIds().Where(id => !Rise.Application.CalmBoardArrangement.TopIds.Contains(id))
            : MainTopLevelIds();

    /// <summary>Currently-hidden, non-disabled Main widgets the add-widget slot can show, with their titles.</summary>
    private IEnumerable<(string Id, string Title)> HiddenMainWidgets() =>
        Layout.TopLevelWidgets()
            .Where(w => w.Zone == Rise.Domain.WidgetZone.Main && !w.Visible && !IsWidgetDisabled(w.Id))
            .Select(w => (w.Id, WidgetDefinitions.FirstOrDefault(d => d.Id == w.Id)?.Title ?? w.Id));

    /// <summary>The active layout's name, for the Edit board bar.</summary>
    private string ActiveLayoutName => Collection.Active?.Name ?? Rise.Domain.LayoutCollection.DefaultName;

    /// <summary>Whether a widget's module is switched off. Unclaimed widgets are never filtered.</summary>
    private bool IsWidgetDisabled(string id) =>
        ModuleCatalog.ForWidget(id) is Rise.Domain.ModuleInfo module && DisabledModules.Contains(module.Id);

    /// <summary>Whether the widget's definition is lazy metadata: its assembly loads on first show, through the container.</summary>
    private bool IsLazy(string id) =>
        WidgetDefinitions.OfType<LazyWidgetDefinition>().Any(d => d.Id == id);

    private bool IsGroup(string id) =>
        WidgetDefinitions.FirstOrDefault(d => d.Id == id)?.IsGroup ?? false;

    private async Task SwitchLayoutAsync(ChangeEventArgs args)
    {
        if (args.Value is string id)
        {
            await LayoutService.SetActiveLayoutAsync(id);
        }
    }

    private async Task ApplyDArrangementAsync() =>
        await LayoutService.ApplyCalmBoardArrangementAsync();

    private async Task ShowHiddenWidgetAsync(string id)
    {
        await LayoutService.ShowWidgetAsync(id);
        AddWidgetMenuOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Layout = await LayoutService.LoadAsync();
        Collection = await LayoutService.LoadCollectionAsync();
        LayoutService.Changed += OnLayoutChanged;
        await RefreshDisabledAsync();
        ModuleService.Changed += OnModulesChanged;
        ShowHint = !IsHintDismissed();
        await PreviewFeatureService.LoadAsync();
        await RefreshBoardFlagsAsync();
        PreviewFeatureService.Changed += OnPreviewFeaturesChanged;
        await BackgroundService.LoadAsync();
        BackgroundCss = await BackgroundService.GetCssAsync();
        BackgroundService.Changed += OnBackgroundChanged;
        await HotkeyService.LoadAsync();
        HotkeyRef = DotNetObjectReference.Create(this);
        try
        {
            JSInProcess.InvokeVoid("riseHotkeys.register", HotkeyRef);
        }
        catch (JSException)
        {
            // No global listener: hotkeys stay inert, but the palette still opens from its button.
        }
    }

    /// <summary>
    /// Called by the document keydown listener for every keystroke the
    /// listener forwards (it already skips keystrokes typed into
    /// editable fields, except modifier shortcuts and Escape). Unknown
    /// keystrokes are ignored; a matched action runs, and the palette
    /// trigger toggles the palette.
    /// </summary>
    [JSInvokable]
    public async Task OnHotkeyKeyDown(string key, bool mod, bool alt, bool shift)
    {
        string? action = HotkeyService.TryMatch(key, mod, alt, shift);
        switch (action)
        {
            case "open-palette":
                PaletteOpen = !PaletteOpen;
                break;
            case "toggle-edit-layout":
                EditingLayout = !EditingLayout;
                break;
            case "toggle-theme":
                await FlipThemeAsync();
                break;
            default:
                return;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Light becomes dark, dark becomes light, and anything else (system, custom) lands on light.</summary>
    private async Task FlipThemeAsync()
    {
        string next = await ThemeStore.GetStoredThemeAsync() switch
        {
            "light" => "dark",
            "dark" => "light",
            _ => "light",
        };
        await ThemeStore.SetStoredThemeAsync(next);
        await ThemeStore.ApplyThemeAsync(next);
    }

    private void ClosePalette()
    {
        PaletteOpen = false;
    }

    private void ToggleEditLayoutFromPalette()
    {
        EditingLayout = !EditingLayout;
        PaletteOpen = false;
    }

    private async Task RefreshDisabledAsync() =>
        DisabledModules = await ModuleService.DisabledIdsAsync(ModuleCatalog.Modules);

    /// <summary>Reads the dismiss flag through the shell's riseStorage helper.</summary>
    private bool IsHintDismissed()
    {
        try
        {
            return JSInProcess.Invoke<string?>("riseStorage.get", HintDismissedKey) is not null;
        }
        catch (JSException)
        {
            // Storage unreadable: treat the hint as dismissed rather than nagging on every load.
            return true;
        }
    }

    private void DismissHint()
    {
        try
        {
            JSInProcess.InvokeVoid("riseStorage.set", HintDismissedKey, "1");
        }
        catch (JSException)
        {
            // The flag didn't stick, but the hint still goes away for this session.
        }

        ShowHint = false;
    }

    private async void OnLayoutChanged(object? sender, EventArgs args)
    {
        Layout = await LayoutService.LoadAsync();
        Collection = await LayoutService.LoadCollectionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnModulesChanged(object? sender, EventArgs args)
    {
        await RefreshDisabledAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnPreviewFeaturesChanged(object? sender, EventArgs args)
    {
        await RefreshBoardFlagsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnBackgroundChanged(object? sender, EventArgs args)
    {
        BackgroundCss = await BackgroundService.GetCssAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshBoardFlagsAsync()
    {
        CalmBoardPreview = await PreviewFeatureService.IsEnabledAsync(Rise.Domain.PreviewFeatures.CalmBoard);
        CalmBoardLandscapePreview = await PreviewFeatureService.IsEnabledAsync(Rise.Domain.PreviewFeatures.CalmBoardLandscape);
        CalmBoardFullPreview = await PreviewFeatureService.IsEnabledAsync(Rise.Domain.PreviewFeatures.CalmBoardFull);
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (disposing)
        {
            LayoutService.Changed -= OnLayoutChanged;
            ModuleService.Changed -= OnModulesChanged;
            PreviewFeatureService.Changed -= OnPreviewFeaturesChanged;
            BackgroundService.Changed -= OnBackgroundChanged;
            try
            {
                JSInProcess.InvokeVoid("riseHotkeys.unregister");
            }
            catch (JSException)
            {
                // The page is going away; a stale listener is harmless.
            }

            HotkeyRef?.Dispose();
        }
    }
}
